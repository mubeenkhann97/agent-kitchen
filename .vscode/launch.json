  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Agent Kitchen extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "env": { "AGENT_KITCHEN_OPEN_ON_START": "live" }
    },
    {
      "name": "Run Agent Kitchen extension (demo)",
